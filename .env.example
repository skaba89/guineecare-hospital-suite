# =============================================================================
# GuinéeCare Hospital Suite — Environment template (dev / local)
# =============================================================================
# Copy this file to `.env` and adjust values. Never commit the real `.env`.
#
#   cp .env.example .env
#   # edit .env, then:
#   docker compose up -d
# =============================================================================

# --- App / environment ---
ENVIRONMENT=local
APP_NAME=GuineeCare Hospital Suite

# --- Database ---
# Dev uses SQLite. Production MUST use PostgreSQL (see .env.production.template).
DATABASE_URL=sqlite:///./dev_guineecare.db
DB_PASSWORD=guineecare

# --- Security ---
# JWT signing secret. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production, MUST be ≥32 bytes of random data. Empty = dev convenience (warns).
AUTH_SECRET=dev-secret-key-change-in-prod

# Token TTL (minutes). 60 = 1 hour access token.
TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# JSON array of allowed origins, or comma-separated list.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]

# --- Trusted proxies (v0.9.0+) ---
# Comma-separated CIDR/IP list. Only these IPs may set X-Forwarded-For.
# Empty = no proxy trusted (use raw remote_addr).
# In prod behind nginx, set to the Docker bridge subnet.
TRUSTED_PROXIES=

# --- Observability (v0.7.0+) ---
# Optional bearer token for /metrics endpoint. Empty = /metrics open (dev only).
METRICS_TOKEN=

# --- Bootstrap (v0.9.0+) ---
# Optional token for POST /users/bootstrap. Empty = bootstrap endpoint disabled
# in non-local envs (use CLI `python -m app.cli create-superuser`).
BOOTSTRAP_TOKEN=

# --- Demo data seeding (dev only) ---
# Set to true for first-time dev setup. FORBIDDEN in production (enforced at startup).
SEED_DEMO_DATA=true

# --- Vite frontend (build-time) ---
VITE_API_BASE_URL=http://localhost/api/v1
