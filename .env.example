# =============================================================================
# GuinéeCare Hospital Suite — Configuration locale (développeur)
# =============================================================================
# Mode : DÉVELOPPEMENT LOCAL
# Usage :
#   cp .env.example .env
#   # éditer si besoin, puis :
#   docker compose up -d
#   # ou pour dev sans Docker :
#   cd backend && source .venv/bin/activate && uvicorn app.main:app --reload
#   cd frontend && npm run dev
#
# ⚠️ Ce fichier est pour le DÉVELOPPEMENT uniquement.
# Pour la production, utiliser .env.production.template
# Pour la démo Render, utiliser .env.demo.template
# =============================================================================

# ─── Application ─────────────────────────────────────────────
ENVIRONMENT=local
APP_NAME=GuineeCare Hospital Suite

# ─── Base de données ─────────────────────────────────────────
# Dev : SQLite (fichier local). Prod : PostgreSQL (voir .env.production.template).
DATABASE_URL=sqlite:///./dev_guineecare.db
# DB_PASSWORD n'est utilisé qu'en mode PostgreSQL (docker-compose).
DB_PASSWORD=guineecare

# ─── Sécurité ────────────────────────────────────────────────
# JWT signing secret. Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# En production, DOIT être ≥ 32 bytes aléatoires.
AUTH_SECRET=dev-secret-key-change-in-prod

# Durée de validité du token d'accès JWT (minutes). 60 = 1 heure.
TOKEN_EXPIRE_MINUTES=60

# ─── CORS ────────────────────────────────────────────────────
# JSON array des origines autorisées, ou liste séparée par virgules.
# En dev, on autorise localhost sur plusieurs ports (Vite 5173, React 3000).
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]

# ─── Proxies de confiance (v0.9.0+) ──────────────────────────
# Liste séparée par virgules de CIDR/IP. Seules ces IPs peuvent set X-Forwarded-For.
# Vide = aucun proxy de confiance (utilise remote_addr brut).
# En prod derrière nginx, mettre le subnet Docker bridge (ex: 172.16.0.0/12).
TRUSTED_PROXIES=

# ─── Logs (v2.3.0 — Phase 8) ─────────────────────────────────
# Niveau de log : DEBUG, INFO (défaut), WARNING, ERROR, CRITICAL
# DEBUG = logs détaillés (SQL, requêtes) — utile pour diagnostiquer
# INFO = logs de production (défaut)
LOG_LEVEL=INFO

# ─── Observabilité (v0.7.0+) ─────────────────────────────────
# Token optionnel pour /metrics. Vide = /metrics ouvert (dev seulement).
# En prod, METTRE un token fort (≥ 32 chars).
METRICS_TOKEN=

# ─── Bootstrap (v0.9.0+) ─────────────────────────────────────
# Token optionnel pour POST /users/bootstrap. Vide = endpoint désactivé
# en non-local. Utiliser `python -m app.cli create-superuser` à la place.
BOOTSTRAP_TOKEN=

# ─── Données de démonstration ────────────────────────────────
# true = charge 50 patients, 20 établissements, etc. (dev/démo uniquement)
# false = base vide (production)
# ⚠️ INTERDIT en production (vérifié au démarrage — main.py)
SEED_DEMO_DATA=true

# ─── Frontend Vite (build-time) ──────────────────────────────
# URL de l'API backend pour le build Vite.
# Dev avec Docker : http://localhost/api/v1 (via nginx)
# Dev sans Docker : http://localhost:8000/api/v1 (direct uvicorn)
VITE_API_BASE_URL=http://localhost/api/v1

# ─── SMS (optionnel) ─────────────────────────────────────────
# Clé de chiffrement Fernet pour les credentials SMS providers.
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Vide = SMS désactivé (provider Mock — logs console uniquement)
SMS_FERNET_KEY=
